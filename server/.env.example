# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 允许跨域的前端来源（逗号分隔）。开发期走 vite 代理时用不到，
# 但直接访问后端（不经代理）或前后端不同域时需要
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传目录与单文件大小上限（字节，默认 5MB，与前端 PromptInput 的限制保持一致）
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# 数据库：默认 SQLite，文件落在 DATA_DIR 目录（相对 server/ 运行目录，已在 .gitignore 中忽略）
DATA_DIR=data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 生成任务超时（秒）
GEN_TIMEOUT_SECONDS=300

# 生成占位实现的模拟耗时（秒），接入真实模型后可忽略
GEN_MOCK_DELAY_SECONDS=2.4
